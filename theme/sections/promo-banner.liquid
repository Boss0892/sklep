<section class="promo">
  <div class="promo__bg">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 2200 }}"
        alt=""
        loading="lazy"
        width="2200"
        height="{{ 2200 | divided_by: section.settings.image.aspect_ratio | round }}"
      >
    {%- endif -%}
  </div>
  <div class="container promo__inner">
    <div class="promo__content surface">
      <h2 class="section-title" style="margin:0 0 10px 0">{{ section.settings.heading }}</h2>
      <p class="muted" style="margin:0 0 18px 0">{{ section.settings.subheading }}</p>
      {%- if section.settings.link != blank -%}
        <a class="btn btn--cta" href="{{ section.settings.link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "CUSTOMUJ. JEDŹ. DOMINUJ." },
    { "type": "text", "id": "subheading", "label": "Podtytuł", "default": "Odkryj naszą pełną ofertę akcesoriów" },
    { "type": "text", "id": "button_label", "label": "Przycisk — tekst", "default": "Zobacz ofertę" },
    { "type": "url", "id": "link", "label": "Przycisk — link", "default": "/collections/all" },
    { "type": "image_picker", "id": "image", "label": "Tło (opcjonalne)" }
  ],
  "presets": [{ "name": "Promo banner" }]
}
{% endschema %}

