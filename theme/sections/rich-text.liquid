<section class="richtext">
  <div class="container">
    <div class="richtext__panel surface">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title" style="margin:0 0 10px 0">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="richtext__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Technicznie i konkretnie" },
    { "type": "richtext", "id": "text", "label": "Treść", "default": "<p>Wybierz model, dobierz część i jedź dalej. Bez lania wody.</p>" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}

