<nav class="breadcrumbs" aria-label="Okruszki">
  <div class="container breadcrumbs__inner">
    <a href="{{ routes.root_url }}">Strona główna</a>
    {%- if template.name == 'collection' and collection -%}
      <span aria-hidden="true">/</span>
      <a href="{{ collection.url }}">{{ collection.title }}</a>
    {%- elsif template.name == 'product' and product -%}
      {%- if collection -%}
        <span aria-hidden="true">/</span>
        <a href="{{ collection.url }}">{{ collection.title }}</a>
      {%- endif -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title }}</span>
    {%- elsif template.name == 'page' and page -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ page.title }}</span>
    {%- elsif template.name == 'cart' -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ 'general.cart.title' | t }}</span>
    {%- elsif template.name == 'search' -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">Szukaj</span>
    {%- endif -%}
  </div>
</nav>

{% schema %}
{
  "name": "Breadcrumbs",
  "settings": [],
  "presets": [{ "name": "Breadcrumbs" }]
}
{% endschema %}

