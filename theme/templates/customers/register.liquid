<main class="container" style="padding:56px 0">
  <div class="surface" style="padding:18px; width:min(560px,100%); margin-inline:auto">
    <h1 class="section-title" style="margin:0 0 14px 0">{{ 'customer.register' | t }}</h1>
    {% form 'create_customer' %}
      <div class="grid grid--2">
        <label>
          <span class="product__label">Imię</span>
          <input class="search__input" type="text" name="customer[first_name]" autocomplete="given-name" required>
        </label>
        <label>
          <span class="product__label">Nazwisko</span>
          <input class="search__input" type="text" name="customer[last_name]" autocomplete="family-name" required>
        </label>
      </div>
      <div class="stack" style="margin-top:12px">
        <label>
          <span class="product__label">Email</span>
          <input class="search__input" type="email" name="customer[email]" autocomplete="email" required>
        </label>
        <label>
          <span class="product__label">Hasło</span>
          <input class="search__input" type="password" name="customer[password]" autocomplete="new-password" required>
        </label>
        <button class="btn btn--cta" type="submit">{{ 'customer.register' | t }}</button>
      </div>
    {% endform %}
  </div>
</main>

